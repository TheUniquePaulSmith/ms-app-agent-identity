{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Copy this file to appsettings.json (git-ignored) and fill in the
  // <placeholders> from your own tenant; docs/entra-setup.md says where each comes from.

  // ------------------------------------------------------------------
  // Identity 1: the HOST APPLICATION (App Registration "POC Claims Web").
  // Used for browser sign-in (OIDC), for validating pasted bearer tokens
  // whose audience is this app, and as the client for scenarios 1 and 2.
  // ------------------------------------------------------------------
  "HostApplication": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<directory (tenant) id>",
    "ClientId": "<host app client id>",
    "CallbackPath": "/signin-oidc",

    // Delegated scope this app exposes. /auth/token mints a token for it,
    // and /claims/{id}/archive-as-user requires it.
    "ApiScope": "api://<host app client id>/access_as_user",

    "ClientCredentials": [
      {
        "SourceType": "ClientSecret",
        "ClientSecret": "<host app client secret>"
      }
    ]
  },

  // ------------------------------------------------------------------
  // Identity 2: the AGENT IDENTITY BLUEPRINT ("POC Claims Analysis Agent
  // Blueprint"). It is the only agent object that holds a credential.
  // It mints tokens AS the agent identity below (scenarios 3 and 4), and
  // it is the audience of the incoming token for scenario 4.
  // ------------------------------------------------------------------
  "AgentBlueprint": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<directory (tenant) id>",
    "ClientId": "<blueprint client id>",

    // Delegated scope the blueprint exposes. /auth/token mints a token for
    // it, and /claims/{id}/agent-analyze-as-user requires it.
    "ApiScope": "api://<blueprint client id>/access_agent",

    "ClientCredentials": [
      {
        "SourceType": "ClientSecret",
        "ClientSecret": "<blueprint client secret>"
      }
    ]
  },

  // ------------------------------------------------------------------
  // Identity 3: the AGENT IDENTITY ("POC Claims Analysis Agent").
  // A service principal with no credential of its own. Passed to
  // WithAgentIdentity(); the downstream API sees it as the caller.
  // ------------------------------------------------------------------
  "AgentIdentity": {
    "ClientId": "<agent identity client id>"
  },

  // ------------------------------------------------------------------
  // Local LLM (OpenAI-compatible, e.g. vLLM). The UI's Connection tab can
  // override these per browser; they are the defaults.
  // ------------------------------------------------------------------
  "Llm": {
    "BaseUrl": "http://localhost:8000/v1",
    "ApiKey": "not-needed",
    "Model": ""
  },

  // ------------------------------------------------------------------
  // Identity 4: the MCP SERVER ("POC Claims MCP Server"). It is the
  // audience of every token the agent loop mints: the host app requests
  // api://<ClientId>/.default (Scope overrides that), the MCP server
  // validates it, authorizes on Mcp.* scopes/roles, then exchanges it for
  // a Claims API token with its own credential (claims-mcp/server.mjs).
  // ------------------------------------------------------------------
  "McpServer": {
    "Endpoint": "http://localhost:5002/mcp",
    "ClientId": "<mcp server client id, printed by Configure/Configure-McpEntra.ps1>",
    "Scope": "api://<mcp server client id>/.default"
  },

  // ------------------------------------------------------------------
  // "Local LLM & Gateway MCP" tab (docs/Proposal.md layers 4 and 5). The MCP
  // server runs in Azure behind API Management (same Entra registration as
  // above, so the same scope); tool calls run as one of the gateway agents
  // (Agent2-4, docs/test-identities.md) from the same blueprint. Names follow Configure/Bicep/main.bicep with the
  // -NamePrefix given to Deploy-GatewayPoc.ps1. Configure/Configure-Entra.ps1
  // -TestAgents -TestUsers writes AgentIdentityClientId (Agent2) and the test users' object ids; Configure/Deploy-GatewayPoc.ps1 writes the URLs,
  // InternalKey, KillSwitchWorkflowUrl (Logic App trigger, with its SAS) and
  // StorageConnectionString (the "PDP entities" sub-tab writes the PDP's
  // entity registry, table PdpEntitiesTable, straight into the storage account).
  // ------------------------------------------------------------------
  "GatewayMcp": {
    "Endpoint": "<written by Configure/Deploy-GatewayPoc.ps1>",
    "Scope": "api://<mcp server client id>/.default",
    "AgentIdentityClientId": "<written by Configure/Configure-Entra.ps1 -TestAgents (Agent2)>",
    "PdpUrl": "<written by Configure/Deploy-GatewayPoc.ps1>",
    "KillSwitchUrl": "<written by Configure/Deploy-GatewayPoc.ps1>",
    "ClaimsApiUrl": "<written by Configure/Deploy-GatewayPoc.ps1>",
    "InternalKey": "<written by Configure/Deploy-GatewayPoc.ps1>",
    "KillSwitchWorkflowUrl": "<written by Configure/Deploy-GatewayPoc.ps1>",
    "StorageConnectionString": "<written by Configure/Deploy-GatewayPoc.ps1>",
    "PdpEntitiesTable": "PdpEntities",
    // Object ids of test users User1-3 (PDP playground presets); written by Configure-Entra.ps1 -TestUsers.
    "User1ObjectId": "<written by Configure/Configure-Entra.ps1 -TestUsers>",
    "User2ObjectId": "<written by Configure/Configure-Entra.ps1 -TestUsers>",
    "User3ObjectId": "<written by Configure/Configure-Entra.ps1 -TestUsers>"
  },

  // ------------------------------------------------------------------
  // Agent identities the gateway tab can act as (the "Agent identity"
  // drop-down). All come from the same blueprint (AgentBlueprint:ClientId).
  // GatewayMcp:AgentIdentityClientId is the default selection.
  // Configure/Configure-Entra.ps1 -TestAgents fills in Agent1-4
  // (docs/test-identities.md); -NewAgent "<name>" creates more and appends
  // them here. Whether the PDP lets an agent through depends on its
  // entity registry, table PdpEntities (agent-must-be-registered).
  // ------------------------------------------------------------------
  "GatewayAgentIdentities": [
    { "Name": "POC Claims Limited Gateway Agent (Agent2)", "ClientId": "<run Configure/Configure-Entra.ps1 -TestAgents>", "Note": "Agent2: registered in the PDP, autonomous limit 10,000 (limited)" },
    { "Name": "POC Claims Senior Gateway Agent (Agent3)", "ClientId": "<run Configure/Configure-Entra.ps1 -TestAgents>", "Note": "Agent3: registered in the PDP, autonomous limit 50,000 (greater access)" },
    { "Name": "POC Claims Rogue Agent, Unregistered (Agent4)", "ClientId": "<run Configure/Configure-Entra.ps1 -TestAgents>", "Note": "Agent4: Entra grants it MCP permissions, but it is not registered in the PDP, so the gateway refuses it" },
    { "Name": "POC Claims Local Analysis Agent (Agent1)", "ClientId": "<run Configure/Configure-Entra.ps1 -TestAgents>", "Note": "Agent1: the local tabs' agent; not registered in the PDP, so the gateway refuses it" }
  ],

  // ------------------------------------------------------------------
  // The downstream resource ("POC Claims API"); its app id goes in the
  // Scopes below. Same URL and scope for both entries; AuthenticationOptionsName selects WHOSE credential mints
  // the token: "Bearer" = HostApplication, "AgentBlueprint" = blueprint.
  // ------------------------------------------------------------------
  "DownstreamApis": {
    "ClaimsApiAsHostApplication": {
      "BaseUrl": "http://localhost:5001",
      "RelativePath": "/api",
      "Scopes": [ "api://<claims api client id>/.default" ],
      "AcquireTokenOptions": {
        "AuthenticationOptionsName": "Bearer"
      }
    },
    "ClaimsApiAsAgent": {
      "BaseUrl": "http://localhost:5001",
      "RelativePath": "/api",
      "Scopes": [ "api://<claims api client id>/.default" ],
      "AcquireTokenOptions": {
        "AuthenticationOptionsName": "AgentBlueprint"
      }
    }
  }
}
